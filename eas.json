{
  "cli": {
    "version": ">= 21.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "playstore": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_DECENT_DISTRIBUTION": "playstore"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
